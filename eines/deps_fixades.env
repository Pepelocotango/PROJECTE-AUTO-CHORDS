# eines/deps_fixades.env — versions FIXADES i SHA256 de tot el que baixa el
# projecte (scripts d'eines/ i workflows de GitHub Actions).
#
# Es llegeix amb `source` des de bash:
#     . eines/deps_fixades.env
#
# ── COM S'ACTUALITZA UNA VERSIÓ ─────────────────────────────────────────────
# 1. Canvia la versió/URL aquí (i, si cal, al script que la fa servir).
# 2. Calcula el SHA256 nou amb l'eina del projecte:
#        python3 eines/baixa_verificat.py "<URL>" - /tmp/x
#    El `-` vol dir «no verifiquis: digues-me el hash» → és la confiança en el
#    PRIMER ús. A partir d'aquí el hash queda fixat aquí i es verifica SEMPRE.
# 3. Enganxa el hash a la variable ..._SHA256 corresponent.
# 4. Comprova que la baixada verificada funciona de debò:
#        python3 eines/baixa_verificat.py "<URL>" "<SHA256>" /tmp/x
#
# ⚠️ No canviïs cap versió sense comprovar que el build segueix funcionant; a
#    macOS, a més, cal mantenir el mínim 10.13 (`eines/verifica_minos_macos.py`).

# ── CPython portable (python-build-standalone; build GENÈRIC sense AVX) ─────
# Usat per: eines/crea_portable.sh
PYBS_TAG=20261003
PYBS_PYV=3.12.15
PYBS_FILE="cpython-${PYBS_PYV}+${PYBS_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz"
PYBS_URL="https://github.com/astral-sh/python-build-standalone/releases/download/${PYBS_TAG}/cpython-${PYBS_PYV}%2B${PYBS_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz"
PYBS_SHA256=f937814031eab4698ca6d07ec606ede1825768f3f3e99af76d9db3900bee03c5

# ── ffmpeg estàtic de Linux (johnvansickle) ─────────────────────────────────
# Usat per: eines/crea_portable.sh. URL AMB VERSIÓ explícita (no «release»).
FFMPEG_LINUX_VER=7.0.2
FFMPEG_LINUX_FILE="ffmpeg-${FFMPEG_LINUX_VER}-amd64-static.tar.xz"
FFMPEG_LINUX_URL="https://johnvansickle.com/ffmpeg/releases/${FFMPEG_LINUX_FILE}"
FFMPEG_LINUX_SHA256=abda8d77ce8309141f83ab8edf0596834087c52467f6badf376a6a2a4c87cf67

# ── appimagetool (AppImage) ─────────────────────────────────────────────────
# Usat per: eines/crea_appimage.sh. Release AMB TAG (no «continuous»).
APPIMAGETOOL_VER=1.9.1
APPIMAGETOOL_URL="https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VER}/appimagetool-x86_64.AppImage"
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

# ── ffmpeg de macOS (evermeet.cx) ───────────────────────────────────────────
# Usat per: .github/workflows/build-macos.yml. URL AMB VERSIÓ (no «getrelease»).
FFMPEG_MAC_VER=9.0.2
FFMPEG_MAC_URL="https://evermeet.cx/ffmpeg/ffmpeg-${FFMPEG_MAC_VER}.zip"
FFMPEG_MAC_SHA256=4acc0be580f9b2788029eb7bd4d645ff87968911b0a62aeeb3940d42d54558d5

# ── ffmpeg de Windows (gyan.dev) ────────────────────────────────────────────
# Usat per: .github/workflows/build-windows.yml. URL AMB VERSIÓ explícita.
FFMPEG_WIN_VER=9.0.2
FFMPEG_WIN_URL="https://www.gyan.dev/ffmpeg/builds/packages/ffmpeg-${FFMPEG_WIN_VER}-essentials_build.zip"
FFMPEG_WIN_SHA256=60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba

# ── Icones Lucide (raw.githubusercontent) ───────────────────────────────────
# Usat per: eines/baixa_icones.sh. Són molts fitxers petits: es fixa el TAG
# (no té sentit un SHA256 per icona).
LUCIDE_TAG=1.56.0

# ── Repositoris que es COMPILEN: es fixa el COMMIT (no un SHA256) ───────────
# Usats per: eines/compila_vamp_plugins.sh i .github/workflows/build-macos.yml.
# Els scripts han de fer `git rev-parse HEAD` i comprovar que coincideix.
QM_VAMP_PLUGINS_COMMIT=c918afc070f79489758bb2dab6895972bd82066b
QM_DSP_COMMIT=e34a3cc188332ed7c33cd9257ef164de5b587191
VAMP_PLUGIN_SDK_COMMIT=63e0c3b37b6fb9ce6f074ea8222b4903e4f5568a
LIBSNDFILE_COMMIT=b9103bd48b6c8fb517ae737fe3baee0c718b804c
