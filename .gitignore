# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Entorns virtuals
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Qt / app
*.log
*.tmp

# Editors i sistema
.vscode/
.idea/
*~
*.bak
*.swp
.DS_Store
Thumbs.db

# Dependències locals aïllades (sense sistema, es regeneren)
.deps/
*.deb

# Sortides locals (no es commitegen)
*_obsolets/
midis_acords/
releases/

# CARPETA WAVS PROVES
WAVS_PROVA/


# Concatenació de codi generada (regenerable amb concatena.py)
CODI_concatenat*.txt

# Opcions d'autodeteccio recordades a l'app (locals de cada usuari)
opcions_detecta.json

# Projectes oberts recentment (estat local de cada usuari)
recents.json

# Marcador de sessió oberta (per a la recuperació després d'un crash)
sessio.json

# Traces natives de crash (el .log ja cau a *.log; el .anterior no)
crash_nadiu.log*

# Python/ffmpeg portables (Fase 2-3 de portabilitat; es regeneren)
portable/

# El PAQUET portable construït (va FORA del projecte; per si de cas)
AUTO_CHORDS_PORTABLE/
*_PORTABLE/

# AppImage construida i restes (es regeneren)
*.AppImage
squashfs-root/

# Temp de treball de l'app (log del reproductor, binaris de prova)
temp/

# Cachés d'eines de test / anàlisi estàtica
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv*/

# Restes de merge/patch
*.orig
*.rej

# AppImage: extractes i temporals
*.AppImage.zsync

# Logs de GitHub Actions descarregats (locals; no es commitegen)
LOGS GITHUB ACTIONS/
logs_*/
github-actions-logs/

# carpeta artifacts actions github
00last_artifacts_githubactions/

# Arxiu local (no es commiteja: coses no necessaries que es volen conservar)
OLD/

# Memòria cau de baixades verificades (eines/baixa_verificat.py): els fitxers
# es guarden amb el seu SHA256 com a nom i es reutilitzen entre builds.
.baixades/

# Carpeta temporal per a agents i usuari: no s'ha de versionar.
XX TEMP FILES USUARI/

# Mesura de cobertura (coverage.py): sortides locals, es regeneren.
.coverage
.coverage.*
htmlcov/
.cov-env/

# `AGENTS.md` SÍ que es versiona (és la guia del projecte per a qualsevol agent).
# La resta de fitxers d'agents són locals de cada entorn i NO es versionen.
CLAUDE.md
.cursorrules
.cursor/
.windsurf/
.aider*
.continue/

