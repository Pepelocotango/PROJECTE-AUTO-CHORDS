{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Chords",
  "version": "0.1.0",
  "identifier": "cat.pep.auto-chords",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Chords",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Detector d'acords i estructura amb Chordino + Segmentino",
    "longDescription": "Auto Chords analitza una cançó WAV, en detecta acords (Chordino) i estructura (Segmentino), i n'exporta clips d'àudio llestos per arrossegar a qualsevol DAW.",
    "copyright": "GPLv3 © 2026 Pep"
  }
}