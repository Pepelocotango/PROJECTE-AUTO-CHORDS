{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "subagent_depth": 1,
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm *": "ask",
      "rm -rf *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "chmod -R 777 *": "deny",
      "git commit*": "ask",
      "git push*": "ask",
      "gio trash*": "allow"
    }
  }
}
